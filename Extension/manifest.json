{
  "manifest_version": 3,
  "name": "RematchBridge Gamepad",
  "version": "1.2",
  "description": "Gives Xbox Cloud Gaming and GeForce NOW the controller connected through the RematchBridge Mac app.",
  "content_scripts": [
    {
      "matches": [
        "https://www.xbox.com/*",
        "https://play.geforcenow.com/*",
        "https://hardwaretester.com/*"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.xbox.com/*",
        "https://play.geforcenow.com/*",
        "https://hardwaretester.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
